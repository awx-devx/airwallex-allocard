# Copy to .env and fill in. Never commit .env — it is gitignored.
# Generate AUTH_SECRET with: openssl rand -base64 32
# Use the Airwallex *demo* API only (api-demo.airwallex.com). Do not point this at production.

MONGODB_URI=
MONGODB_DB=allocard
REDIS_URL=

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_API_VERSION=2024-02-22
AIRWALLEX_ACCOUNT_ID=

# Replay recorded Airwallex responses. Tests default to true; leave unset (false) for live demo issuing.
# AIRWALLEX_USE_FIXTURES=true

REMOTE_AUTH_MODE=simulate

ROLE=
ADMIN_JOB_SECRET=
WORKER_SCHEDULER_ENABLED=true
